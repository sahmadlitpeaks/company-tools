# ==============================================================================
# AG Holding Internal Company Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root to override default settings:
#   cp .env.example .env
#
# NOTE: For local development using Docker Compose (`docker compose up --build`),
# all settings have functional local defaults and the platform boots out of the box
# without creating a .env file.
#
# For Staging and Production deployments, review and configure the variables below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
# Target environment: 'development', 'staging', or 'production'
# In 'production', cookies are marked Secure (HTTPS required) and weak secrets will abort boot.
ENVIRONMENT=development

# Host port mapped to the single-origin frontend Nginx container (default: 8080)
APP_PORT=8080

# Host port mapped to the FastAPI backend container (default: 8000, needed for local Vite dev)
BACKEND_PORT=8000

# Secret key used to sign session cookies and JWTs.
# SECURITY REQUIREMENT: In production, this MUST be set to a cryptographically secure
# random string of at least 32 characters (e.g., generated with: openssl rand -hex 32).
SECRET_KEY=change-me-to-a-long-random-string

# Public-facing base URL where users reach the app (e.g., https://tools.agholding.net).
# If left blank, the platform automatically derives the URL from the incoming HTTP Host/Forwarded headers.
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080

# Comma-separated CORS allowed origins. Production Nginx serves frontend and backend on the same origin.
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated email domains allowed to sign up / sign in (e.g., agholding.net,subsidiary.com).
# Leave empty to allow any corporate domain. New accounts require admin approval by default.
ALLOWED_EMAIL_DOMAINS=

# Enable in-process scheduler for recurring background jobs (warranty/maintenance alerts)
RUN_SCHEDULER=true

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL credentials used by the bundled db container in docker-compose.yml
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

# Backend database connection string (SQLAlchemy async psycopg3 driver).
# In Docker Compose, the database service is named 'db':
DATABASE_URL=postgresql+psycopg://platform:platform@db:5432/platform
# If running backend directly on the host outside Docker, use:
# DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Set to true to log all raw SQL queries to console (development/debugging only)
SQL_ECHO=false

# ------------------------------------------------------------------------------
# 3. INITIAL BOOTSTRAP ADMINISTRATOR
# ------------------------------------------------------------------------------
# On a fresh database with no existing users, the backend seeds this initial admin account.
# The user is forced to change their password upon their very first login.
DEFAULT_ADMIN_EMAIL=admin@agholding.net
# SECURITY REQUIREMENT: In production, DEFAULT_ADMIN_PASSWORD must be changed from 'admin'.
DEFAULT_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 4. MICROSOFT ENTRA ID (AZURE AD) SSO (Optional)
# ------------------------------------------------------------------------------
# Configure if employees will sign in via Microsoft 365 / Azure AD OAuth.
# If left empty, local email/password authentication remains active.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Callback URL registered in Microsoft Entra ID App Registrations:
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/callback

# ------------------------------------------------------------------------------
# 5. STORAGE & AUTOMATED BACKUPS
# ------------------------------------------------------------------------------
# Container internal storage mounts (persisted via Docker volumes)
MEDIA_ROOT=/data/media
BACKUP_ROOT=/data/backups

# Hour of day (0-23 in Asia/Dubai time zone) to run automated daily backup dump
BACKUP_HOUR_DUBAI=2

# Number of days to retain automated database and media backups
BACKUP_RETENTION_DAYS=30

# Maximum file size allowed when importing a backup ZIP (bytes; default 5 GB)
BACKUP_IMPORT_MAX_BYTES=5368709120

# ------------------------------------------------------------------------------
# 6. AI HELP DESK / KNOWLEDGE BASE ASSISTANT (Optional)
# ------------------------------------------------------------------------------
# Enables the AI Knowledge Base assistant widget. If left empty, AI Help is cleanly disabled.
# Compatible with OpenAI or any OpenAI-compatible API endpoint (Azure OpenAI, Ollama, vLLM, etc.)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_INPUT_CHARS=2000
AI_MAX_CONTEXT_CHARS=12000

# ------------------------------------------------------------------------------
# 7. SHAREPOINT INTELLIGENCE MODULE (Optional)
# ------------------------------------------------------------------------------
# Enable read-only SharePoint indexing, compliance extraction, and search.
SHAREPOINT_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
SHAREPOINT_REDIRECT_URI=http://localhost:8080/api/sharepoint/callback

# Fernet encryption key for Microsoft tokens and historical encrypted records.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHAREPOINT_ENCRYPTION_KEY=
SHAREPOINT_PREVIOUS_ENCRYPTION_KEYS=

# OpenAI configuration for SharePoint document synthesis and risk extraction
SHAREPOINT_OPENAI_API_KEY=
SHAREPOINT_OPENAI_MODEL=gpt-6-luna

# Comma-separated user UUIDs of designated compliance reviewers
SHAREPOINT_REVIEWER_IDS=

# Automatic polling configuration
SHAREPOINT_POLLING_ENABLED=true
SHAREPOINT_SYNC_INTERVAL_SECONDS=60
SHAREPOINT_MAX_FILE_BYTES=26214400
SHAREPOINT_MAX_TEXT_CHARS=200000
SHAREPOINT_MAX_ITEMS=2000
SHAREPOINT_NER_LANGUAGES=ar,en
SHAREPOINT_NER_MODEL_DIR=/data/nlp-models
SHAREPOINT_PARSER_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# 8. SMTP EMAIL SERVICE (Optional)
# ------------------------------------------------------------------------------
# Used for sending secure-transfer links, notifications, and alerts.
# Brevo: smtp-relay.brevo.com:587 with STARTTLS, the account's SMTP login,
# an SMTP key (not the API key), and a verified sender in SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# 9. OUTBOUND WEBHOOK NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# Master switch to fan-out platform notifications to Slack / Microsoft Teams
NOTIFY_OUTBOUND=false
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
