# Optional overrides for `docker compose up --build`.
#
# The stack boots with sensible defaults and needs NO .env to run locally — copy
# this to `.env` only if you want to change the port, set production values, or
# wire up Azure SSO / SMTP. Every value below shows its built-in default.

# ---- Where the whole app is served ----
# Host port mapped to the frontend's nginx (the single origin for everything).
APP_PORT=8080

# ---- App ----
# Set to `production` on a live deployment. On production a fresh database is
# seeded with ONLY the bootstrap admin below — no sample departments or leave
# types — so the admin sets everything up from scratch. It also disables the
# sample-data seeder (the "Demo data" card stops rendering) — see ALLOW_DEMO_SEED.
# Outside production those defaults are seeded for dev/test convenience.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Force-enable sample data even on production. Leave false for a real install;
# there is no reason to turn this on outside a demo environment.
ALLOW_DEMO_SEED=false
# Public URLs used for QR/short-link/card URLs + SSO redirects. Leave BLANK to
# auto-derive from the request host, so the app works on any IP/domain with no
# config (e.g. http://<your-server-ip>:8080). Set them only to pin a fixed
# domain or to force https behind TLS termination.
PUBLIC_BASE_URL=
FRONTEND_BASE_URL=
BACKEND_CORS_ORIGINS=http://localhost:8080

# ---- Bootstrap admin (created only on a brand-new, empty database) ----
# You'll be forced to change this password on first login — the rest of the API
# is refused until you do. Still set a real password here on a live deployment:
# the default below is public knowledge, and the window before you log in is
# enough for someone else to claim the account.
DEFAULT_ADMIN_EMAIL=admin@agholding.net
DEFAULT_ADMIN_PASSWORD=admin

# ---- Database (the bundled Postgres service) ----
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

# ---- Azure Entra ID (optional; password sign-in works without it) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Defaults to ${PUBLIC_BASE_URL}/api/auth/callback when left unset.
AZURE_REDIRECT_URI=

# ---- SMTP ----
# Required in practice: this is how a new joiner receives their temporary
# password, and how a password reset reaches them. With SMTP unset, accounts are
# still created and usable but the platform shows the temporary password to the
# admin on screen to pass on by hand. Also used for secure-transfer links and
# notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agholding.net
