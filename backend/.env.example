# ==============================================================================
# AG Holding Internal Platform - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the backend/ or project root directory:
#   cp .env.example .env
# ==============================================================================

# Core Application
APP_NAME=AG Holding Internal Platform
ENVIRONMENT=development
SQL_ECHO=false
SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
ALLOWED_EMAIL_DOMAINS=
RUN_SCHEDULER=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Bootstrap Admin
DEFAULT_ADMIN_EMAIL=admin@agholding.net
DEFAULT_ADMIN_PASSWORD=admin

# Azure Entra ID SSO (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Storage & Backups
MEDIA_ROOT=./media
MEDIA_URL=/media
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_DUBAI=2
BACKUP_IMPORT_MAX_BYTES=5368709120

# AI Help (Knowledge Base Assistant - Optional)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_INPUT_CHARS=2000
AI_MAX_CONTEXT_CHARS=12000

# SharePoint Intelligence (Optional)
SHAREPOINT_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
SHAREPOINT_REDIRECT_URI=http://localhost:5173/api/sharepoint/callback
SHAREPOINT_ENCRYPTION_KEY=
SHAREPOINT_PREVIOUS_ENCRYPTION_KEYS=
SHAREPOINT_OPENAI_API_KEY=
SHAREPOINT_OPENAI_MODEL=gpt-6-luna
SHAREPOINT_REVIEWER_IDS=
SHAREPOINT_POLLING_ENABLED=true
SHAREPOINT_SYNC_INTERVAL_SECONDS=60
SHAREPOINT_MAX_FILE_BYTES=26214400
SHAREPOINT_MAX_TEXT_CHARS=200000
SHAREPOINT_MAX_ITEMS=2000
SHAREPOINT_NER_LANGUAGES=ar,en
SHAREPOINT_NER_MODEL_DIR=./nlp-models
SHAREPOINT_PARSER_TIMEOUT_SECONDS=120

# SMTP Email (Optional). For Brevo, use smtp-relay.brevo.com:587,
# STARTTLS=true, your SMTP login, an SMTP key (not the API key), and a
# verified sender address in SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Outbound Webhooks (Optional)
NOTIFY_OUTBOUND=false
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
